# Entity: ship

main: kit: entity: ship: {

  alias: field: {}

  fields: [
    {
      name: "abs"
      req: false
      short: "ABS number"
      type: "`$INTEGER`"
    }
    {
      name: "class"
      req: false
      short: "Ship class"
      type: "`$INTEGER`"
    }
    {
      name: "course_deg"
      req: false
      short: "Course in degrees"
      type: "`$NUMBER`"
    }
    {
      name: "home_port"
      req: false
      short: "Home port"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Ship ID"
      type: "`$STRING`"
    }
    {
      name: "image"
      req: false
      short: "Image URL"
      type: "`$STRING`"
    }
    {
      name: "imo"
      req: false
      short: "IMO number"
      type: "`$INTEGER`"
    }
    {
      name: "last_ais_update"
      req: false
      short: "Last AIS update timestamp"
      type: "`$STRING`"
    }
    {
      name: "latitude"
      req: false
      short: "Latitude"
      type: "`$NUMBER`"
    }
    {
      name: "launches"
      req: false
      short: "Launch IDs"
      type: "`$ARRAY`"
    }
    {
      name: "legacy_id"
      req: false
      short: "Legacy ID"
      type: "`$STRING`"
    }
    {
      name: "link"
      req: false
      short: "Link to ship info"
      type: "`$STRING`"
    }
    {
      name: "longitude"
      req: false
      short: "Longitude"
      type: "`$NUMBER`"
    }
    {
      name: "mass_kg"
      req: false
      short: "Mass in kilograms"
      type: "`$INTEGER`"
    }
    {
      name: "mass_lbs"
      req: false
      short: "Mass in pounds"
      type: "`$INTEGER`"
    }
    {
      name: "mmsi"
      req: false
      short: "MMSI number"
      type: "`$INTEGER`"
    }
    {
      name: "model"
      req: false
      short: "Ship model"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Ship name"
      type: "`$STRING`"
    }
    {
      name: "roles"
      req: false
      short: "Ship roles"
      type: "`$ARRAY`"
    }
    {
      name: "speed_kn"
      req: false
      short: "Speed in knots"
      type: "`$NUMBER`"
    }
    {
      name: "status"
      req: false
      short: "Ship status"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Ship type"
      type: "`$STRING`"
    }
    {
      name: "year_built"
      req: false
      short: "Year built"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "ship"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/ships"
          parts: [
            "ships"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/ships/{id}"
          parts: [
            "ships"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

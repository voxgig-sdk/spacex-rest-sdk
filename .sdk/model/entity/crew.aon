# Entity: crew

main: kit: entity: crew: {

  alias: field: {}

  fields: [
    {
      name: "agency"
      req: false
      short: "Agency"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Crew member ID"
      type: "`$STRING`"
    }
    {
      name: "image"
      req: false
      short: "Image URL"
      type: "`$STRING`"
    }
    {
      name: "launches"
      req: false
      short: "Launch IDs"
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: false
      short: "Crew member name"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Status (active, inactive, retired, unknown)"
      type: "`$STRING`"
    }
    {
      name: "wikipedia"
      req: false
      short: "Wikipedia URL"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "crew"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/crew"
          parts: [
            "crew"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/crew/{id}"
          parts: [
            "crew"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

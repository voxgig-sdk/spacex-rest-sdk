# Entity: launchpad

main: kit: entity: launchpad: {

  alias: field: {}

  fields: [
    {
      name: "detail"
      req: false
      type: "`$STRING`"
    }
    {
      name: "full_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "latitude"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "launch"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "launch_attempt"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "launch_success"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "locality"
      req: false
      type: "`$STRING`"
    }
    {
      name: "longitude"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "region"
      req: false
      type: "`$STRING`"
    }
    {
      name: "rocket"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "launchpad"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/launchpads"
          parts: [
            "launchpads"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/launchpads/{id}"
          parts: [
            "launchpads"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

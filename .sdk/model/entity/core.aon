# Entity: core

main: kit: entity: core: {

  alias: field: {}

  fields: [
    {
      name: "asds_attempts"
      req: false
      short: "Number of autonomous spaceport drone ship landing attempts"
      type: "`$INTEGER`"
    }
    {
      name: "asds_landings"
      req: false
      short: "Number of successful ASDS landings"
      type: "`$INTEGER`"
    }
    {
      name: "block"
      req: false
      short: "Core block number"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Core serial number"
      type: "`$STRING`"
    }
    {
      name: "last_update"
      req: false
      short: "Last update about the core"
      type: "`$STRING`"
    }
    {
      name: "launches"
      req: false
      short: "Launch IDs"
      type: "`$ARRAY`"
    }
    {
      name: "reuse_count"
      req: false
      short: "Number of times core has been reused"
      type: "`$INTEGER`"
    }
    {
      name: "rtls_attempts"
      req: false
      short: "Number of return to launch site attempts"
      type: "`$INTEGER`"
    }
    {
      name: "rtls_landings"
      req: false
      short: "Number of successful RTLS landings"
      type: "`$INTEGER`"
    }
    {
      name: "serial"
      req: false
      short: "Core serial number"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Core status (active, inactive, unknown, expended, lost, retired)"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "core"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/cores"
          parts: [
            "cores"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cores/{id}"
          parts: [
            "cores"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

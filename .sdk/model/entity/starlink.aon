# Entity: starlink

main: kit: entity: starlink: {

  alias: field: {}

  fields: [
    {
      name: "height_km"
      req: false
      short: "Current height in kilometers"
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: false
      short: "Starlink satellite ID"
      type: "`$STRING`"
    }
    {
      name: "latitude"
      req: false
      short: "Current latitude"
      type: "`$NUMBER`"
    }
    {
      name: "launch"
      req: false
      short: "Launch ID"
      type: "`$STRING`"
    }
    {
      name: "longitude"
      req: false
      short: "Current longitude"
      type: "`$NUMBER`"
    }
    {
      name: "spaceTrack"
      req: false
      short: "Space-Track.org data"
      type: "`$OBJECT`"
    }
    {
      name: "velocity_kms"
      req: false
      short: "Current velocity in km/s"
      type: "`$NUMBER`"
    }
    {
      name: "version"
      req: false
      short: "Satellite version"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "starlink"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/starlink"
          parts: [
            "starlink"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/starlink/{id}"
          parts: [
            "starlink"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.spaceTrack`"
          }
        }
      ]
    }
  }



}

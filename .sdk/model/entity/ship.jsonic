# Entity: ship

main: kit: entity: ship: {

  alias: field: {}

  fields: [
    {
      name: "abs"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "class"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "course_deg"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "home_port"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "image"
      req: false
      type: "`$STRING`"
    }
    {

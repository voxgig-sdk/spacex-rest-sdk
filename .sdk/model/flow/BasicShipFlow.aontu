# BasicShipFlow

main: kit: flow: BasicShipFlow:
{
  entity: "ship",
  kind: "basic",
  name: "BasicShipFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "ship_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ship_ref01",
        srcdatavar: "ship_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "ship01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ship_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicShipFlow"
}
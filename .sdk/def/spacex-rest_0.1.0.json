  "components": {
    "schemas": {
      "Launch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Launch ID"
          },
          "flight_number": {
            "type": "integer",
            "description": "Flight number"
          },
          "name": {
            "type": "string",
            "description": "Launch name"
          },
          "date_utc": {
            "type": "string",
            "format": "date-time",
            "description": "Launch date in UTC"
          },
          "date_unix": {
            "type": "integer",
            "description": "Launch date in unix timestamp"
          },
          "date_local": {
            "type": "string",
            "format": "date-time",
            "description": "Launch date in local time"
          },
          "date_precision": {
            "type": "string",
            "description": "Date precision (hour, day, month, quarter, half, year)"
          },
          "static_fire_date_utc": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Static fire date in UTC"
          },
          "static_fire_date_unix": {
            "type": "integer",
            "nullable": true,
            "description": "Static fire date in unix timestamp"
          },
          "tdb": {
            "type": "boolean",
            "description": "To be determined"
          },
          "net": {
            "type": "boolean",
            "description": "No earlier than"
          },
          "window": {
            "type": "integer",
            "description": "Launch window in seconds"
          },
          "rocket": {
            "type": "string",
            "description": "Rocket ID"
          },
          "success": {
            "type": "boolean",
            "nullable": true,
            "description": "Launch success status"
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Launch failures"
          },
          "upcoming": {
            "type": "boolean",
            "description": "Whether the launch is upcoming"
          },
          "details": {
            "type": "string",
            "nullable": true,
            "description": "Launch details"
          },
          "fairings": {
            "type": "object",
            "nullable": true,
            "properties": {
              "reused": {
                "type": "boolean"
              },
              "recovery_attempt": {
                "type": "boolean"
              },
              "recovered": {
                "type": "boolean"
              },
              "ships": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "crew": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Crew member IDs"
          },
          "ships": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ship IDs"
          },
          "capsules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Capsule IDs"
          },
          "payloads": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Payload IDs"
          },
          "launchpad": {
            "type": "string",
            "description": "Launchpad ID"
          },
          "cores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "core": {
                  "type": "string",
                  "description": "Core ID"
                },
                "flight": {
                  "type": "integer",
                  "description": "Core flight number"
                },
                "gridfins": {
                  "type": "boolean",
                  "description": "Whether core has grid fins"
                },
                "legs": {
                  "type": "boolean",
                  "description": "Whether core has legs"
                },
                "reused": {
                  "type": "boolean",
                  "description": "Whether core was reused"
                },
                "landing_attempt": {
                  "type": "boolean",
                  "description": "Whether landing was attempted"
                },
                "landing_success": {
                  "type": "boolean",
                  "nullable": true,
                  "description": "Whether landing was successful"
                },
                "landing_type": {
                  "type": "string",
                  "nullable": true,
                  "description": "Landing type (ASDS, RTLS, Ocean)"
                },
                "landpad": {
                  "type": "string",
                  "nullable": true,
                  "description": "Landing pad ID"
                }
              }
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "patch": {
                "type": "object",
                "properties": {
                  "small": {
                    "type": "string",
                    "nullable": true
                  },
                  "large": {
                    "type": "string",
                    "nullable": true
                  }
                }
              },
              "reddit": {
                "type": "object",
                "properties": {
                  "campaign": {
                    "type": "string",
                    "nullable": true
                  },
                  "launch": {
                    "type": "string",
                    "nullable": true
                  },
                  "media": {
                    "type": "string",
                    "nullable": true
                  },
                  "recovery": {
                    "type": "string",
                    "nullable": true
                  }
                }
              },
              "flickr": {
                "type": "object",
                "properties": {
                  "small": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "original": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "presskit": {
                "type": "string",
                "nullable": true
              },
              "webcast": {
                "type": "string",
                "nullable": true
              },
              "youtube_id": {
                "type": "string",
                "nullable": true
              },
              "article": {
                "type": "string",
                "nullable": true
              },
              "wikipedia": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "auto_update": {
            "type": "boolean",
            "description": "Whether the launch data is automatically updated"
          }
        }
      },
      "Rocket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Rocket ID"
          },
          "name": {
            "type": "string",
            "description": "Rocket name"
          },
          "type": {
            "type": "string",
            "description": "Rocket type"
          },
          "active": {
            "type": "boolean",
            "description": "Whether the rocket is active"
          },
          "stages": {
            "type": "integer",
            "description": "Number of stages"
          },
          "boosters": {
            "type": "integer",
            "description": "Number of boosters"
          },
          "cost_per_launch": {
            "type": "integer",
            "description": "Cost per launch in USD"
          },
          "success_rate_pct": {
            "type": "number",
            "description": "Success rate percentage"
          },
          "first_flight": {
            "type": "string",
            "format": "date",
            "description": "Date of first flight"
          },
          "country": {
            "type": "string",
            "description": "Country of origin"
          },
          "company": {
            "type": "string",
            "description": "Company"
          },
          "height": {
            "type": "object",
            "properties": {
              "meters": {
                "type": "number"
              },
              "feet": {
                "type": "number"
              }
            }
          },
          "diameter": {
            "type": "object",
            "properties": {
              "meters": {
                "type": "number"
              },
              "feet": {
                "type": "number"
              }
            }
          },
          "mass": {
            "type": "object",
            "properties": {
              "kg": {
                "type": "integer"
              },
              "lb": {
                "type": "integer"
              }
            }
          },
          "flickr_images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
